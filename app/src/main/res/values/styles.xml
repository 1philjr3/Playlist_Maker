<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="mainScreenButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="iconPadding">@dimen/padding_after_icon</item>
        <item name="android:layout_weight">1</item>
        <item name="backgroundTint">@color/white</item>
        <item name="textAllCaps">false</item>
        <item name="android:textColor">@color/activity_main_text_color</item>
        <item name="android:textSize">@dimen/text_size_big</item>
        <item name="cornerRadius">@dimen/corner_radius</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/black</item>
        <item name="fontFamily">@font/ys_display_regular</item>

    </style>

    <style name="headerTextViewStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_marginStart">@dimen/common_padding</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="fontFamily">@font/ys_display_medium</item>
    </style>

    <style name="settingsIcons">
        <item name="tint">@color/gray</item>
    </style>

    <style name="backButtonStyle">
        <item name="tint">@color/black</item>
    </style>

    <style name="switchStyle">
        <item name="thumbTint">@color/gray</item>
        <item name="trackTint">@color/gray_light</item>
    </style>

    <style name="editTextStyle">
        <item name="android:textColorHint">@color/gray</item>
    </style>

    <style name="blackAndWhite">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="searchButtonsStyle">
        <item name="android:backgroundTint">@color/black</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="cornerRadius">@dimen/corner_radius</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="searchIcons">
        <item name="tint">@color/gray</item>
    </style>

    <style name="audio_player_left_border_style">
        <item name="android:layout_marginLeft">@dimen/common_padding</item>
        <item name="android:textSize">13sp</item>
        <item name="fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">@color/gray</item>
    </style>

    <style name="audio_player_right_border_style">
        <item name="android:layout_marginRight">@dimen/common_padding</item>
        <item name="android:textSize">13sp</item>
        <item name="fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="FAB_color">
        <item name="backgroundTint">@color/blue</item>
    </style>

    <style name="like_button_style">
        <item name="backgroundTint">@color/gray</item>
    </style>

    <style name="media_library_text_style">
        <item name="fontFamily">@font/ys_display_bold</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="tab_layout_style">
        <item name="tabIndicatorColor">@color/black</item>
        <item name="android:background">@color/white</item>
        <item name="tabTextColor">@color/black</item>
    </style>

    <style name="tab_text_style" parent="TextAppearance.Design.Tab">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>
    
    <style name="bottomNavigationViewStyle">
        <item name="android:background">@color/white</item>
        <item name="itemIconTint">@color/bottom_nav_color_not_night</item>
        <item name="itemTextColor">@color/bottom_nav_color_not_night</item>
    </style>

    <style name="new_playlist_editText_style">
        <item name="android:textColorHint">@color/black_and_white</item>
        <item name="android:textSize">@dimen/text_size_small</item>
    </style>

    <style name="rounded_image_view">
        <item name="cornerSize">8dp</item>
    </style>


    <style name="dialog_style" parent="">
        <item name="colorPrimary">@color/blue</item>
    </style>


    <style name="Base.Theme.PDFNoteMate" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/main_color</item>
        <item name="colorSecondary">@color/second_color</item>
    </style>

    <style name="Theme.PDFNoteMate" parent="Base.Theme.PDFNoteMate" />

<!--    //-->

    <style name="TextInputLayoutStyle" parent="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">#D9D7D7</item>
        <item name="boxStrokeWidth">1.0dip</item>
    </style>


    <style name="LoginSignupButton" parent="@style/Widget.AppCompat.Button">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/shape_login_button2</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="GoogleLoginButton" parent="@style/Widget.AppCompat.Button">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#ff2e2f50</item>
        <item name="android:background">@drawable/shape_google_login_button</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44.0dip</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">10.0dip</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>


    <style name="SocialLoginButton" parent="@style/Widget.AppCompat.Button">
        <item name="android:textSize">16.0sp</item>
        <item name="android:textColor">#ff2e2f50</item>
        <item name="android:layout_width">55.0dip</item>
        <item name="android:layout_height">55.0dip</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">20.0dip</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>


    <style name="Theme.Login" parent="@style/Theme.Apps">
        <item name="android:colorBackground">@color/white</item>
        <item name="android:statusBarColor">#D5E8DA</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <style name="DialogButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/black</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!-- Стиль для ActionMode (панели с кнопками Edit/Delete) -->
    <style name="ReadingActionModeStyle" parent="Widget.AppCompat.ActionMode">
        <item name="background">@color/reading_menu_background</item>
        <item name="titleTextStyle">@style/ReadingActionModeTitleStyle</item>
    </style>
    
    <style name="ReadingActionModeTitleStyle" parent="TextAppearance.AppCompat.Widget.ActionMode.Title">
        <item name="android:textColor">@color/directory_item_text</item>
    </style>

    <!-- Стили для диалогов удаления -->
    <style name="DeleteDialogStyle" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="buttonBarPositiveButtonStyle">@style/DeleteDialogPositiveButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/DeleteDialogNegativeButtonStyle</item>
        <item name="android:background">@color/dialog_delete_background</item>
        <item name="android:textColor">@color/dialog_delete_text</item>
        <item name="android:textColorPrimary">@color/dialog_delete_text</item>
    </style>
    
    <style name="DeleteDialogPositiveButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/dialog_delete_positive_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>
    
    <style name="DeleteDialogNegativeButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/dialog_delete_negative_button</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Стили для диалогов переименования -->
    <style name="RenameDialogStyle" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="buttonBarPositiveButtonStyle">@style/RenameDialogPositiveButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/RenameDialogNegativeButtonStyle</item>
        <item name="android:background">@color/dialog_delete_background</item>
        <item name="android:textColor">@color/dialog_delete_text</item>
        <item name="android:textColorPrimary">@color/dialog_delete_text</item>
    </style>
    
    <style name="RenameDialogPositiveButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/dialog_delete_negative_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>
    
    <style name="RenameDialogNegativeButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/dialog_delete_positive_button</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Стили для диалогов загрузки файлов -->
    <style name="UploadDialogButtonCancel" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/blue</item>
        <item name="android:textAllCaps">true</item>
    </style>
    
    <style name="UploadDialogButtonAction" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/blue</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Стили для диалогов добавления директории -->
    <style name="AddDirectoryDialogStyle" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="buttonBarPositiveButtonStyle">@style/AddDirectoryDialogPositiveButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/AddDirectoryDialogNegativeButtonStyle</item>
        <item name="android:background">@color/card_background</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="colorPrimary">@color/blue</item>
    </style>
    
    <style name="AddDirectoryDialogPositiveButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/blue</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>
    
    <style name="AddDirectoryDialogNegativeButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/red</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Стиль для кнопки выбора изображения в светлой теме -->
    <style name="ImageSelectButtonStyle" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/blue</item>
    </style>

</resources>